APP_NAME="Soul Coffeemate"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://api.your-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soul_coffee
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
# `database` needs something to actually run `php artisan queue:work` — a persistent process
# (supervisor/systemd) or, on hosting that offers neither, a cron entry calling
# `queue:work --stop-when-empty` on a short interval. Without one, PublishOutboxEvent (the job
# that calls the broadcaster below) is written to the `jobs` table and never executes — every
# realtime notification silently never arrives, regardless of which broadcaster is configured.
# This is independent of BROADCAST_CONNECTION: switching Reverb <-> Pusher does not fix it.

# Evidence photos and signatures are served from storage — run `php artisan storage:link`.
FILESYSTEM_DISK=public

# ── Realtime (Pusher Channels) ───────────────────────────────────────────────
# Requirement 3 (notifications without a reload) depends on this actually being configured AND
# on the queue worker above actually running — both, not either.
#
# Pusher, not self-hosted Reverb: Reverb needs a persistent `reverb:start` process reachable
# from the internet on its own port or through a reverse-proxied WebSocket upgrade. Neither is
# possible on shared hosting with no supervisor/systemd and no control over the web server's
# proxy rules — confirmed against this host: a raw WS upgrade to the API domain returned
# Laravel's own 404 page (nothing proxies it anywhere), and the raw Reverb port timed out (the
# host firewall drops it). Pusher is a hosted service reachable over plain HTTPS from both the
# Laravel backend (to publish) and the mobile app (to subscribe), so neither problem applies.
#
# Get these four values from the Pusher Channels dashboard → your app → "App Keys".
# PUSHER_APP_KEY and PUSHER_APP_CLUSTER also go in soul_coffe.mobile's app.json
# (pusherKey/pusherCluster) — PUSHER_APP_ID and PUSHER_APP_SECRET stay here ONLY, never in the
# mobile app or in git.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

# ── Business rules (tunable without a deploy) ────────────────────────────────
# Kitchen operating window. Requests outside it are flagged `out_of_hours`, not blocked (E12).
SOUL_OPERATING_OPEN=06:00
SOUL_OPERATING_CLOSE=21:00

# Morning allocation above the standardised target by more than this percentage escalates to
# Finance. Without it, over-allocating in the morning bypasses the requirement-4 approval gate.
SOUL_ALLOCATION_OVER_TARGET_TOLERANCE=20

# Evidence photo must be freshly captured (R3/E6) — an older photo is rejected.
SOUL_EVIDENCE_MAX_AGE_MINUTES=15
SOUL_EVIDENCE_DEDUPE_DAYS=7
SOUL_EVIDENCE_RETRY_WINDOW_MINUTES=10

# Per-line quantity ceiling (R7, §9).
SOUL_MAX_QTY_PER_LINE=100

# ── AI features (Gemini) ─────────────────────────────────────────────────────
# Powers "Generate dengan AI" in the News Feed editor (NewsArticleGenerator) and the
# Dashboard sales-insight summary. Get a key from https://aistudio.google.com/apikey
# ("Create API key") — both features degrade to a clear "not configured" notice when this is
# empty, neither is required for the rest of the app to run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
