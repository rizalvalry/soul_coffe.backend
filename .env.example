APP_NAME="Soul Coffeemate"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://api.your-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soul_coffee
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Evidence photos and signatures are served from storage — run `php artisan storage:link`.
FILESYSTEM_DISK=public

# ── Realtime (Laravel Reverb) ────────────────────────────────────────────────
# Requirement 3 (notifications without a reload) depends on this. Reverb is a long-running
# process: run `php artisan reverb:start` under supervisor/pm2, not per-request.
# Behind a reverse proxy, REVERB_HOST is the PUBLIC hostname the phone connects to, while
# REVERB_SERVER_HOST/PORT is what the process binds locally.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.your-domain.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ── Business rules (tunable without a deploy) ────────────────────────────────
# Kitchen operating window. Requests outside it are flagged `out_of_hours`, not blocked (E12).
SOUL_OPERATING_OPEN=06:00
SOUL_OPERATING_CLOSE=21:00

# Morning allocation above the standardised target by more than this percentage escalates to
# Finance. Without it, over-allocating in the morning bypasses the requirement-4 approval gate.
SOUL_ALLOCATION_OVER_TARGET_TOLERANCE=20

# Evidence photo must be freshly captured (R3/E6) — an older photo is rejected.
SOUL_EVIDENCE_MAX_AGE_MINUTES=15
SOUL_EVIDENCE_DEDUPE_DAYS=7

# Per-line quantity ceiling (R7, §9).
SOUL_MAX_QTY_PER_LINE=100
